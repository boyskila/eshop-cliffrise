---
type Props = {
  text: string
  href: string
}

const { text, href } = Astro.props
---

<a
  {href}
  target="_blank"
  rel="noopener noreferrer"
  class="font-bold
    tracking-wider
    uppercase
    text-center
    px-4 py-2
    lg:px-6 md:py-3 text-base
    md:text-lg lg:text-2xl
    bg-black text-white hover:bg-black/90 hover:text-white"
>
  {text}
</a>
