---
import { getTranslations } from '@utils/i18'
import GalleryCarousel from '../ui/carousel/GalleryCarousel'
import YearToggle from './YearToggle.astro'
import { getImage } from 'astro:assets'
import { galleryImages2025, galleryImages2026 } from '@data/carousel-images'

const { eventsSection, tetevenClimb } = getTranslations(Astro.params)
const { text } = eventsSection

const processGalleryImages = (images: typeof galleryImages2025) =>
  Promise.all(
    images.map((img) =>
      getImage({
        src: img,
        widths: [400, 800, 1200],
        format: 'webp',
        quality: 80,
      }),
    ),
  )

const [processedGalleryImages2025, processedGalleryImages2026] =
  await Promise.all([
    processGalleryImages(galleryImages2025),
    processGalleryImages(galleryImages2026),
  ])
const galleryImageUrls2025 = processedGalleryImages2025.map((img) => img.src)
const galleryImageUrls2026 = processedGalleryImages2026.map((img) => img.src)
---

<section
  class="bg-gray-100 pt-8 pb-6 md:pb-8 lg:pt-15 px-5 md:px-15 xl:px-55 mb-10 xl:mb-20"
>
  <div
    class="mb-5 xl:mb-3 flex flex-col gap-5 lg:flex-row lg:gap-10 lg:items-center"
  >
    <h2
      id="events-section"
      class="nafta-brush text-[45px] md:text-[55px] lg:text-[80px] whitespace-nowrap lg:basis-1/3"
    >
      {tetevenClimb}
    </h2>
    <p class="px-6 text-lg/6 xl:text-xl md:pl-10 lg:p-0 lg:basis-2/3">
      {text}
    </p>
  </div>

  <div class="relative">
    <YearToggle />
    <div class="overflow-x-hidden flex items-start justify-center">
      <div data-year-panel="2026" class="w-full">
        <GalleryCarousel images={galleryImageUrls2026} client:idle />
      </div>
      <div data-year-panel="2025" class="hidden w-full">
        <GalleryCarousel images={galleryImageUrls2025} client:idle />
      </div>
    </div>
  </div>
</section>
