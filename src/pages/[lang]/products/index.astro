---
import MainLayout from '@layouts/MainLayout.astro'
import ProductCardImage from '@components/products/ProductCardImage.astro'
import { Price } from '@components/ui/Price'
import { getProducts } from '@data/products'
import { getLang, getTranslations } from '@utils/i18'

const translations = getTranslations(Astro.params)
const lang = getLang(Astro.params)
const products = await getProducts(lang)
const sortedProducts = [...products].sort((firstProduct, secondProduct) => {
  const firstOrder = firstProduct.carouselOrder ?? Number.POSITIVE_INFINITY
  const secondOrder = secondProduct.carouselOrder ?? Number.POSITIVE_INFINITY

  return firstOrder - secondOrder
})
---

<MainLayout
  title={translations.products}
  seoTitle={translations.seo.products.title}
  description={translations.seo.products.description}
  showHero={false}
>
  <section
    id="products"
    class="flex-col justify-center px-3 py-12 md:px-15 md:py-16"
  >
    <h1
      class="nafta-brush text-[45px] md:text-[55px] lg:text-[80px] mb-4 text-center leading:10 md:leading-20 md:mb-10"
    >
      {translations.products}
    </h1>
    <p
      class="mx-auto mb-10 max-w-3xl px-3 text-center text-lg text-gray-600 md:text-xl"
    >
      {translations.seo.products.description}
    </p>
    <div data-products-list class="-mx-2 flex flex-wrap gap-y-12">
      {
        sortedProducts.map((product) => (
          <div class="w-full px-2 phone-landscape:w-1/2 md:w-1/2 lg:w-1/3 2xl:w-1/4">
            <article
              data-product-card
              class="flex h-full flex-col items-center justify-center gap-3 md:gap-4 xl:gap-5"
            >
              <a
                class="group relative block h-full w-full p-0 transition-none hover:opacity-100"
                href={product.href}
              >
                <ProductCardImage src={product.image} alt={product.name} />
                {product.hoverImage && (
                  <ProductCardImage
                    src={product.hoverImage}
                    alt=""
                    isHoverImage
                  />
                )}
              </a>
              <div class="flex w-full justify-between gap-2">
                <div class="flex flex-col gap-1 md:gap-2 lg:gap-3">
                  <a
                    href={product.href}
                    class="p-0 text-base leading-5 font-semibold underline-offset-4 hover:underline md:text-lg xl:text-2xl"
                  >
                    {product.name}
                  </a>
                  <div class="text-[19px] font-extrabold lg:text-xl xl:text-2xl">
                    <Price
                      amount={product.price}
                      amountBgn={product.priceBgn}
                      {lang}
                      bgnClass="text-sm md:text-base"
                    />
                  </div>
                </div>
                <a
                  data-product-buy-link
                  href={product.href}
                  aria-label={`${translations.buyNow}: ${product.name}`}
                  class="flex max-h-10 w-20 items-center justify-center bg-black text-base leading-none tracking-[2px] text-white uppercase phone-portrait:h-9 phone-landscape:h-9 lg:text-lg"
                >
                  {translations.buyNow}
                </a>
              </div>
            </article>
          </div>
        ))
      }
    </div>
  </section>
</MainLayout>
