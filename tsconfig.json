{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": [
    "dist",
    "dist-playwright",
    "playwright-report",
    "test-results",
    "node_modules"
  ],
  "compilerOptions": {
    "paths": {
      "@constants": ["./src/constants"],
      "@types": ["./src/types"],
      "@utils/*": ["./src/utils/*"],
      "@data/*": ["./src/data/*"],
      "@actions": ["./src/actions/"],
      "@signals/*": ["./src/signals/*"],
      "@services/*": ["./src/services/*"],
      "@components/*": ["./src/components/*"],
      "@assets/*": ["./src/assets/*"],
      "@layouts/*": ["./src/layouts/*"]
    },
    "jsx": "preserve",
    "jsxImportSource": "solid-js"
  }
}
